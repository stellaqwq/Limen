# npm run init generates real random secrets; do not use example values.
# Most keys apply as soon as they are saved from the settings page. These startup-only keys
# still need a service restart: HOST, PORT, ONEBOT_ACCESS_TOKEN, ADMIN_ACCESS_TOKEN,
# REVERSE_WS_TOKEN, SESSION_KEY, DATA_DIR, QQ_DRIVER, QQ_ACCOUNT, QQ_* paths and ports,
# HEARTBEAT_MS, SEND_* , MEDIA_BASE_URL, MEDIA_MAX_BYTES, ONEBOT_MAX_REQUEST_BYTES,
# HISTORY_RETENTION_DAYS, UNCERTAIN_RETENTION_DAYS, RETAIN_IGNORED_JOB_CONTENT, AI_CONCURRENCY.
HOST=127.0.0.1
PORT=5700
ONEBOT_ACCESS_TOKEN=
# Separate administrator credential; never give this to OneBot plugins.
ADMIN_ACCESS_TOKEN=
# Permit trusted OneBot plugins such as AstrBot Qzone to obtain saved Qzone cookies.
# Disabled by default; only user.qzone.qq.com and qzone.qq.com are accepted.
QZONE_ALLOW_COOKIE_EXPORT=false
SESSION_KEY=
DATA_DIR=./data
# kernel loads the bundled official QQ core through our own host bridge.
QQ_DRIVER=kernel
QQ_RUNTIME_DIR=./runtime/qq
# download: fetch the official QQ installer and verify Tencent's signature on first start (default).
# local: copy an already installed QQ instead.
QQ_RUNTIME_SOURCE=download
QQ_KERNEL_DIR=./runtime/kernel
QQ_KERNEL_DATA=./data/qq-kernel
QQ_ACCOUNT=0
QQ_RPC_TIMEOUT_MS=15000
# Startup includes integrity verification and native kernel loading.
QQ_STARTUP_TIMEOUT_MS=90000
# Wait for SDK shutdown before force stopping an unresponsive host.
QQ_SHUTDOWN_TIMEOUT_MS=5000
# Image input/upload limits; 16 MiB transport fits a 10 MiB base64 image.
ONEBOT_MAX_REQUEST_BYTES=16777216
MEDIA_MAX_BYTES=10485760
MEDIA_TIMEOUT_MS=90000
MEDIA_CACHE_DAYS=7
# Optional reachable OneBot origin for AstrBot on another host/container.
MEDIA_BASE_URL=
# Trusted NTQQ signing endpoint; must match the selected QQ version/profile.
QQ_SIGN_URL=
QQ_SIGN_TOKEN=
# Empty uses the built-in Linux 3.2.26-46494 research profile.
QQ_PROFILE=
QQ_SERVER_HOST=msfwifi.3g.qq.com
QQ_SERVER_PORT=8080
HEARTBEAT_MS=30000
# Comma-separated Universal reverse WS URLs. Empty disables it.
REVERSE_WS_URLS=
REVERSE_WS_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
# AI is opt-in and restricted to explicitly allowed senders/groups.
AI_ENABLED=false
# Stream model text; QQ sends incremental chunks and the web chat updates live.
AI_STREAM_ENABLED=true
AI_SEGMENTED_REPLY_ENABLED=true
AI_STREAM_CHUNK_CHARS=240
# Remove Unicode emoji from AI replies before streaming, sending and AI speech.
# Digits, ordinary text and punctuation remain; emoji-only replies are skipped.
AI_STRIP_EMOJI=true
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_MS=300000

# 本机 Agent（默认关闭；启用前在管理台配置范围）
COMPUTER_ENABLED=false
COMPUTER_ROOTS=./workspace
COMPUTER_DESKTOP_ENABLED=true
COMPUTER_SHELL_ENABLED=false
COMPUTER_QQ_ADMIN_ENABLED=false
COMPUTER_COMMAND_TIMEOUT_MS=15000
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=
# Optional provider-supported reasoning_effort; blank preserves provider defaults.
# High reasoning also needs enough generation tokens and request time.
AI_REASONING_EFFORT=
# Includes reasoning and final output; 0 preserves the provider default.
AI_MAX_OUTPUT_TOKENS=0
# Optional sampling overrides; blank preserves provider defaults.
# Qwen3.5 general thinking: temperature=1, top_p=0.95, presence_penalty=1.5.
AI_TEMPERATURE=
AI_TOP_P=
AI_PRESENCE_PENALTY=
# Vision requires an image-capable model. Documents are extracted locally.
AI_VISION_ENABLED=true
AI_ATTACHMENT_MAX_CHARS=24000
AI_PDF_MAX_PAGES=40
AI_ALLOWED_USERS=
AI_ALLOWED_GROUPS=
AI_GROUP_REQUIRE_AT=true
# Automatic reply formatting; independent of the incoming mention requirement.
# Applies to AI, Chat Plus, message plugins and chat command replies.
REPLY_AT_SENDER=true
REPLY_QUOTE_MESSAGE=true
# Recent messages from allowed groups, including messages that do not mention the bot.
AI_GROUP_CONTEXT_ENABLED=true
AI_GROUP_CONTEXT_MESSAGES=30
AI_GROUP_CONTEXT_TTL_MS=900000
AI_GROUP_CONTEXT_MAX_CHARS=8000
# Only these QQ users can invoke chat / commands. Empty denies all chat commands.
BOT_ADMIN_IDS=
# Only these QQ users keep the personal addressing written in AI_SYSTEM_PROMPT / persona.
# Every other member is addressed by their QQ nickname and cannot be renamed to "主人".
# Empty falls back to BOT_ADMIN_IDS; when both are empty nobody gets the personal addressing.
BOT_PROMPT_OWNER_IDS=
# Permanent group-member block rules: group_id:QQ, one per line or comma-separated.
# Use *:QQ to block the member in every group. Private messages are unaffected.
# Applies before AI, message plugins, chat commands, context and background captions.
# Example only: GROUP_BLOCKED_USERS=1036914541:123456789,*:987654321
GROUP_BLOCKED_USERS=
AI_SYSTEM_PROMPT=你是用户的 QQ AI 助手。简洁、诚实地回答；不要声称自己是人类。群聊中的不同成员是不同用户。
AI_TIMEOUT_MS=45000
# Different conversations may generate concurrently; each conversation stays ordered.
AI_CONCURRENCY=4
AI_MAX_ATTEMPTS=3
AI_CONTEXT_TURNS=-1
AI_MAX_INPUT_CHARS=8000
AI_MAX_REPLY_CHARS=1800
SEND_INTERVAL_MS=1500
SESSION_INTERVAL_MS=3000
# Bound simultaneous sends across conversations; each conversation stays ordered.
SEND_CONCURRENCY=4
MAX_PENDING_SENDS=1000
# Total send attempts per reply; confirmed pre-submission shutdowns do not count.
SEND_MAX_ATTEMPTS=5
JOB_MAX_AGE_MS=600000
MAX_PENDING_JOBS=1000
HISTORY_RETENTION_DAYS=0
# Ignored jobs keep only deduplication metadata by default. False also redacts
# existing ignored job bodies on startup; OneBot/QQ/AstrBot caches are separate.
RETAIN_IGNORED_JOB_CONTENT=false
# Unknown deliveries count towards MAX_PENDING_JOBS; review before this expires.
UNCERTAIN_RETENTION_DAYS=30
# Plugin marketplace: one static index.json. Empty disables the page (no network at all).
# Official catalog: https://raw.githubusercontent.com/stellaqwq/limen-plugin/main/market/index.json
# Docs: docs/MARKET.md
MARKET_CATALOG_URL=
# Extra download hosts besides the catalog's own host, comma separated.
MARKET_ALLOWED_HOSTS=
# Redirect targets allowed for package/asset downloads (max 3 hops). Empty = GitHub asset hosts.
MARKET_REDIRECT_HOSTS=
MARKET_TIMEOUT_MS=30000
MARKET_MAX_PACKAGE_BYTES=33554432
